<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">
    <name>PKG_WMARKA_ARTICLES_GALLERY</name>
    <packagename>wmarka_articles_gallery</packagename>
    <author>Beibit Sakhanov</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Beibit Sakhanov</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorUrl>https://webmarka.kz</authorUrl>
    <version>1.1.0</version>
    <description>PKG_WMARKA_ARTICLES_GALLERY_XML_DESCRIPTION</description>
    <scriptfile>script.php</scriptfile>

    <!-- packages/lib_juimage.zip travels with the package but is installed by script.php only when the site has no JUImage -->
    <files folder="packages">
        <file type="module" id="mod_wmarka_articles_gallery" client="site">mod_wmarka_articles_gallery.zip</file>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/pkg_wmarka_articles_gallery.sys.ini</language>
        <language tag="ru-RU">ru-RU/pkg_wmarka_articles_gallery.sys.ini</language>
        <language tag="kk-KZ">kk-KZ/pkg_wmarka_articles_gallery.sys.ini</language>
    </languages>

    <!-- Joomla checks this file for new versions and shows them in the admin panel -->
    <changelogurl>https://raw.githubusercontent.com/bsakhanov/mod_wmarka_articles_gallery/main/changelog.xml</changelogurl>
    <updateservers>
        <server type="extension" priority="1" name="pkg_wmarka_articles_gallery">https://raw.githubusercontent.com/bsakhanov/mod_wmarka_articles_gallery/main/updates.xml</server>
    </updateservers>
</extension>
