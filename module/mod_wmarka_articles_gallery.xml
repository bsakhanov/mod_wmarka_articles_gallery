<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_WMARKA_ARTICLES_GALLERY</name>
    <author>Beibit Sakhanov</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Beibit Sakhanov</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorUrl>https://webmarka.kz</authorUrl>
    <version>1.1.1</version>
    <description>MOD_WMARKA_ARTICLES_GALLERY_DESC</description>
    <namespace path="src">Webmarka\Module\ArticlesGallery</namespace>

    <files>
        <folder module="mod_wmarka_articles_gallery">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages>
        <language tag="ru-RU">language/ru-RU/mod_wmarka_articles_gallery.ini</language>
        <language tag="ru-RU">language/ru-RU/mod_wmarka_articles_gallery.sys.ini</language>
        <language tag="en-GB">language/en-GB/mod_wmarka_articles_gallery.ini</language>
        <language tag="en-GB">language/en-GB/mod_wmarka_articles_gallery.sys.ini</language>
        <language tag="kk-KZ">language/kk-KZ/mod_wmarka_articles_gallery.ini</language>
        <language tag="kk-KZ">language/kk-KZ/mod_wmarka_articles_gallery.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_BASIC_LABEL">
                <field name="mode" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_MODE_LABEL" default="normal">
                    <option value="normal">MOD_WMARKA_ARTICLES_GALLERY_OPTION_NORMAL_VALUE</option>
                    <option value="dynamic">MOD_WMARKA_ARTICLES_GALLERY_OPTION_DYNAMIC_VALUE</option>
                </field>
                <field name="show_on_article_page" type="radio" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_SHOWONARTICLEPAGE_LABEL" default="1" layout="joomla.form.field.radio.switcher" showon="mode:dynamic">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="catid" type="category" extension="com_content" multiple="true" label="JCATEGORY" layout="joomla.form.field.list-fancy-select" filter="intarray" class="multipleCategories" showon="mode:normal" />
                <field name="show_child_category_articles" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_CHILDCAT_LABEL" default="0" filter="integer">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="levels" type="number" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_CATDEPTH_LABEL" default="1" filter="integer" showon="show_child_category_articles:1" />
                
                <field name="count" type="number" default="8" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_COUNT_LABEL" class="form-control" />
                <field name="show_introtext" type="radio" default="1" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_SHOWINTROTEXT_LABEL" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="introtext_limit" type="number" default="150" min="0" filter="integer" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTROLIMIT_LABEL" class="form-control" showon="show_introtext:1" />
                <field name="introtext_truncate" type="list" default="chars" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_TRUNCATE_LABEL" class="form-select" showon="show_introtext:1">
                    <option value="chars">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TRUNCATE_CHARS</option>
                    <option value="words">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TRUNCATE_WORDS</option>
                </field>
                <field name="introtext_format" type="list" default="plain" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_FORMAT_LABEL" description="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_FORMAT_DESC" class="form-select" showon="show_introtext:1">
                    <option value="plain">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FORMAT_PLAIN</option>
                    <option value="html">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FORMAT_HTML</option>
                </field>
                <field name="articles_layout" type="list" default="items" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_LAYOUT_LABEL" class="form-select">
                    <option value="items">MOD_WMARKA_ARTICLES_GALLERY_OPTION_LAYOUT_ITEMS</option>
                    <option value="titles">MOD_WMARKA_ARTICLES_GALLERY_OPTION_LAYOUT_TITLES</option>
                </field>
            </fieldset>

            <fieldset name="filtering" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_FILTERING_LABEL">
                <field name="show_featured" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FEATURED_LABEL" default="show">
                    <option value="show">JSHOW</option><option value="hide">JHIDE</option><option value="only">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ONLY</option>
                </field>
                <field name="filter_tag" type="tag" label="JTAG" mode="nested" multiple="true" filter="intarray" class="multipleTags" />
                
                <field name="author_filtering_type" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_AUTHORFILTER_LABEL" default="1" filter="integer">
                    <option value="0">MOD_WMARKA_ARTICLES_GALLERY_OPTION_EXCLUDE</option>
                    <option value="1">MOD_WMARKA_ARTICLES_GALLERY_OPTION_INCLUDE</option>
                    <option value="2">MOD_WMARKA_ARTICLES_GALLERY_OPTION_CURRENTUSER</option>
                </field>
                <field name="created_by" type="author" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_AUTHOR_LABEL" multiple="true" layout="joomla.form.field.list-fancy-select" filter="intarray" class="multipleAuthors" showon="author_filtering_type!:2" />
                
                <field name="date_filtering" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_DATEFILTER_LABEL" default="off">
                    <option value="off">MOD_WMARKA_ARTICLES_GALLERY_OPTION_OFF</option>
                    <option value="range">MOD_WMARKA_ARTICLES_GALLERY_OPTION_DATERANGE</option>
                    <option value="relative">MOD_WMARKA_ARTICLES_GALLERY_OPTION_RELATIVEDATE</option>
                </field>
                <field name="date_field" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_DATEFIELD_LABEL" default="a.created" showon="date_filtering!:off">
                    <option value="a.created">MOD_WMARKA_ARTICLES_GALLERY_OPTION_CREATED</option>
                    <option value="a.modified">MOD_WMARKA_ARTICLES_GALLERY_OPTION_MODIFIED</option>
                    <option value="a.publish_up">MOD_WMARKA_ARTICLES_GALLERY_OPTION_PUBLISHED</option>
                </field>
                <field name="start_date_range" type="calendar" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_STARTDATE_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="date_filtering:range" />
                <field name="end_date_range" type="calendar" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_ENDDATE_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="date_filtering:range" />
                <field name="relative_date" type="number" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_RELATIVEDAYS_LABEL" default="30" filter="integer" showon="date_filtering:relative" />
            </fieldset>

            <fieldset name="ordering" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_ORDERING_LABEL">
                <field name="article_ordering" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_ORDERING_LABEL" default="a.created">
                    <option value="a.ordering">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ORDERING</option>
                    <option value="fp.ordering">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ORDERING_FEAT</option>
                    <option value="a.title">JGLOBAL_TITLE</option>
                    <option value="a.id">ID</option>
                    <option value="a.created">MOD_WMARKA_ARTICLES_GALLERY_OPTION_CREATED</option>
                    <option value="modified">MOD_WMARKA_ARTICLES_GALLERY_OPTION_MODIFIED</option>
                    <option value="publish_up">MOD_WMARKA_ARTICLES_GALLERY_OPTION_PUBLISHED</option>
                    <option value="random">MOD_WMARKA_ARTICLES_GALLERY_OPTION_RANDOM</option>
                    <option value="a.hits">MOD_WMARKA_ARTICLES_GALLERY_OPTION_HITS</option>
                </field>
                <field name="article_ordering_direction" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_ORDERDIR_LABEL" default="DESC">
                    <option value="DESC">MOD_WMARKA_ARTICLES_GALLERY_OPTION_DESC</option>
                    <option value="ASC">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ASC</option>
                </field>
                
                <field type="spacer" name="sp_grouping" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_GROUPING_LABEL" hr="true" />
                <field name="article_grouping" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_GROUPING_LABEL" default="none">
                    <option value="none">JNONE</option>
                    <option value="year">MOD_WMARKA_ARTICLES_GALLERY_OPTION_YEAR</option>
                    <option value="month_year">MOD_WMARKA_ARTICLES_GALLERY_OPTION_MONTH_YEAR</option>
                    <option value="author">JAUTHOR</option>
                    <option value="category_title">JCATEGORY</option>
                    <option value="tags">JTAG</option>
                </field>
                <field name="article_grouping_direction" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_GROUPDIR_LABEL" default="ksort" showon="article_grouping!:none">
                    <option value="krsort">MOD_WMARKA_ARTICLES_GALLERY_OPTION_DESC</option>
                    <option value="ksort">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ASC</option>
                </field>
            </fieldset>

            <fieldset name="frontend_filter_fs" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_FRONTEND_FILTER_LABEL">
                <field name="frontend_filter" type="radio" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_LABEL" description="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_DESC" default="1" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="frontend_filter_by" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_BY_LABEL" default="category" showon="frontend_filter:1">
                    <option value="category">JCATEGORY</option>
                    <option value="tag">JTAG</option>
                    <option value="author">JAUTHOR</option>
                    <option value="year">MOD_WMARKA_ARTICLES_GALLERY_OPTION_YEAR</option>
                    <option value="month">MOD_WMARKA_ARTICLES_GALLERY_OPTION_MONTH_YEAR</option>
                </field>
                <field name="frontend_filter_style" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_STYLE_LABEL" default="uk-subnav uk-subnav-divider" showon="frontend_filter:1">
                    <option value="uk-subnav uk-subnav-divider">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FSTYLE_DIVIDER</option>
                    <option value="uk-subnav uk-subnav-pill">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FSTYLE_PILL</option>
                    <option value="uk-tab">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FSTYLE_TAB</option>
                    <option value="uk-button-group">MOD_WMARKA_ARTICLES_GALLERY_OPTION_FSTYLE_BUTTONS</option>
                </field>
                <field name="frontend_filter_align" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_ALIGN_LABEL" default="uk-flex-left" showon="frontend_filter:1">
                    <option value="uk-flex-left">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ALIGN_LEFT</option>
                    <option value="uk-flex-center">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ALIGN_CENTER</option>
                    <option value="uk-flex-right">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ALIGN_RIGHT</option>
                </field>
                <field name="frontend_filter_all" type="text" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_ALL_LABEL" default="" hint="MOD_WMARKA_ARTICLES_GALLERY_FILTER_ALL_DEFAULT" showon="frontend_filter:1" />
                <field name="frontend_filter_anim" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_FFILTER_ANIM_LABEL" default="fade" showon="frontend_filter:1">
                    <option value="slide">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ANIM_SLIDE</option>
                    <option value="fade">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ANIM_FADE</option>
                    <option value="delayed-fade">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ANIM_DELAYED_FADE</option>
                    <option value="false">MOD_WMARKA_ARTICLES_GALLERY_OPTION_ANIM_NONE</option>
                </field>
            </fieldset>

            <fieldset name="uikit_design" label="MOD_WMARKA_ARTICLES_GALLERY_FIELDSET_UIKIT_LABEL">
                <field type="spacer" name="sp_header" label="MOD_WMARKA_ARTICLES_GALLERY_SP_HEADER_LABEL" hr="true" />
                <field name="custom_header" type="text" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_HEADER_TEXT_LABEL" class="form-control" />
                <field name="header_tag" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_HEADER_TAG_LABEL" default="h2" class="form-select">
                    <option value="h1">H1</option><option value="h2">H2</option><option value="h3">H3</option><option value="h4">H4</option><option value="h5">H5</option><option value="h6">H6</option><option value="div">DIV</option>
                </field>
                <field name="header_size" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_SIZE_CLASS_LABEL" default="" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_GALLERY_OPTION_SIZE_NONE</option>
                    <option value="uk-h1">uk-h1</option>
                    <option value="uk-h2">uk-h2</option>
                    <option value="uk-h3">uk-h3</option>
                    <option value="uk-h4">uk-h4</option>
                    <option value="uk-h5">uk-h5</option>
                    <option value="uk-h6">uk-h6</option>
                    <option value="uk-heading-small">uk-heading-small</option>
                    <option value="uk-heading-medium">uk-heading-medium</option>
                    <option value="uk-heading-large">uk-heading-large</option>
                    <option value="uk-heading-xlarge">uk-heading-xlarge</option>
                </field>
                <field name="header_class" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_HEADER_CLASS_LABEL" default="uk-heading-line" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_GALLERY_OPTION_HEADCLASS_NONE</option>
                    <option value="uk-heading-line">MOD_WMARKA_ARTICLES_GALLERY_OPTION_HEADCLASS_LINE</option>
                    <option value="uk-heading-bullet">MOD_WMARKA_ARTICLES_GALLERY_OPTION_HEADCLASS_BULLET</option>
                    <option value="uk-heading-divider">MOD_WMARKA_ARTICLES_GALLERY_OPTION_HEADCLASS_DIVIDER</option>
                </field>

                <field type="spacer" name="sp_lightbox" label="MOD_WMARKA_ARTICLES_GALLERY_SP_LIGHTBOX_LABEL" hr="true" />
                <field name="lightbox_anim" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_LIGHTBOX_ANIM_LABEL" default="slide" class="form-select">
                    <option value="slide">MOD_WMARKA_ARTICLES_GALLERY_OPTION_LIGHTBOX_SLIDE</option>
                    <option value="fade">MOD_WMARKA_ARTICLES_GALLERY_OPTION_LIGHTBOX_FADE</option>
                    <option value="scale">MOD_WMARKA_ARTICLES_GALLERY_OPTION_LIGHTBOX_SCALE</option>
                </field>
                <field name="btn_text" type="text" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_BTN_TEXT_LABEL" default="" hint="MOD_WMARKA_ARTICLES_GALLERY_FIELD_BTN_TEXT_DEFAULT" class="form-control" />
                <field type="spacer" name="sp_tile" label="MOD_WMARKA_ARTICLES_GALLERY_SP_TILE_LABEL" hr="true" />
                <field name="tile_caption" type="list" default="none" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_TILE_CAPTION_LABEL" description="MOD_WMARKA_ARTICLES_GALLERY_FIELD_TILE_CAPTION_DESC" class="form-select">
                    <option value="none">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TILE_NONE</option>
                    <option value="below">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TILE_BELOW</option>
                    <option value="overlay">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TILE_OVERLAY</option>
                    <option value="hover">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TILE_HOVER</option>
                </field>
                <field name="tile_overlay" type="list" default="uk-overlay-primary" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_TILE_OVERLAY_LABEL" class="form-select" showon="tile_caption:overlay,hover">
                    <option value="uk-overlay-primary">MOD_WMARKA_ARTICLES_GALLERY_OPTION_OVERLAY_PRIMARY</option>
                    <option value="uk-overlay-default">MOD_WMARKA_ARTICLES_GALLERY_OPTION_OVERLAY_DEFAULT</option>
                </field>

                <field type="spacer" name="sp_typo" label="MOD_WMARKA_ARTICLES_GALLERY_SP_TYPO_LABEL" hr="true" />
                <field name="item_heading_tag" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_ITEM_TAG_LABEL" default="h3" class="form-select">
                    <option value="h1">H1</option><option value="h2">H2</option><option value="h3">H3</option><option value="h4">H4</option><option value="h5">H5</option><option value="h6">H6</option><option value="div">DIV</option>
                </field>
                <field name="item_heading_size" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_SIZE_CLASS_LABEL" default="uk-h5" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_GALLERY_OPTION_SIZE_NONE</option>
                    <option value="uk-h1">uk-h1</option>
                    <option value="uk-h2">uk-h2</option>
                    <option value="uk-h3">uk-h3</option>
                    <option value="uk-h4">uk-h4</option>
                    <option value="uk-h5">uk-h5</option>
                    <option value="uk-h6">uk-h6</option>
                    <option value="uk-heading-small">uk-heading-small</option>
                    <option value="uk-heading-medium">uk-heading-medium</option>
                    <option value="uk-heading-large">uk-heading-large</option>
                    <option value="uk-text-lead">uk-text-lead</option>
                    <option value="uk-text-large">uk-text-large</option>
                </field>
                <field name="title_classes" type="text" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_TITLE_CLASS_LABEL" default="uk-margin-remove" class="form-control" />
                <field type="spacer" name="sp_intro" label="MOD_WMARKA_ARTICLES_GALLERY_SP_INTRO_LABEL" hr="true" />
                <field name="intro_size" type="list" default="uk-text-small" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_SIZE_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-meta">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_META</option>
                    <option value="uk-text-small">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_SMALL</option>
                    <option value="uk-text-large">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_LARGE</option>
                    <option value="uk-text-lead">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_LEAD</option>
                </field>
                <field name="intro_color" type="list" default="uk-text-muted" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_COLOR_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-muted">MOD_WMARKA_ARTICLES_GALLERY_OPTION_COLOR_MUTED</option>
                    <option value="uk-text-emphasis">MOD_WMARKA_ARTICLES_GALLERY_OPTION_COLOR_EMPHASIS</option>
                    <option value="uk-text-primary">MOD_WMARKA_ARTICLES_GALLERY_OPTION_COLOR_PRIMARY</option>
                    <option value="uk-text-secondary">MOD_WMARKA_ARTICLES_GALLERY_OPTION_COLOR_SECONDARY</option>
                </field>
                <field name="intro_style" type="list" default="" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_STYLE_LABEL" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_GALLERY_OPTION_STYLE_NORMAL</option>
                    <option value="uk-text-italic">MOD_WMARKA_ARTICLES_GALLERY_OPTION_STYLE_ITALIC</option>
                    <option value="uk-text-light">MOD_WMARKA_ARTICLES_GALLERY_OPTION_STYLE_LIGHT</option>
                    <option value="uk-text-bold">MOD_WMARKA_ARTICLES_GALLERY_OPTION_STYLE_BOLD</option>
                </field>
                <field name="intro_align" type="list" default="" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_ALIGN_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-left">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_LEFT</option>
                    <option value="uk-text-center">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_CENTER</option>
                    <option value="uk-text-right">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_RIGHT</option>
                    <option value="uk-text-justify">MOD_WMARKA_ARTICLES_GALLERY_OPTION_TEXT_JUSTIFY</option>
                </field>
                <field name="intro_clamp" type="number" default="0" min="0" max="20" filter="integer" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_CLAMP_LABEL" description="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_CLAMP_DESC" class="form-control" />
                <field name="intro_classes" type="text" default="" hint="uk-margin-small-top" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_INTRO_CLASS_LABEL" class="form-control" />

                <field type="spacer" name="sp_grid" label="MOD_WMARKA_ARTICLES_GALLERY_SP_GRID_LABEL" hr="true" />
                <field name="grid_masonry" type="radio" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_MASONRY_LABEL" default="1" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="grid_match" type="radio" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_MATCH_LABEL" default="0" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="grid_gutter" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_GUTTER_LABEL" default="uk-grid-small" class="form-select">
                    <option value="uk-grid-collapse">MOD_WMARKA_ARTICLES_GALLERY_OPTION_GUTTER_COLLAPSE</option>
                    <option value="uk-grid-small">MOD_WMARKA_ARTICLES_GALLERY_OPTION_GUTTER_SMALL</option>
                    <option value="uk-grid-medium">MOD_WMARKA_ARTICLES_GALLERY_OPTION_GUTTER_MEDIUM</option>
                    <option value="uk-grid-large">MOD_WMARKA_ARTICLES_GALLERY_OPTION_GUTTER_LARGE</option>
                </field>
                
                <field type="spacer" name="sp_cols" label="MOD_WMARKA_ARTICLES_GALLERY_SP_COLS_LABEL" hr="true" />
                <field name="cols_s" type="list" label="MOD_WMARKA_ARTICLES_GALLERY_FIELD_COLS_S_LABEL" default="uk-child-width-1-2@s" class="form-select">
                    <option value="uk-child-width-1-1@s">MOD_WMARKA_ARTICLES_GALLERY_OPTION_COLS_1</option>
